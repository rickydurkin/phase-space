{
  "name": "phase-space",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PHASE SPACE: a deterministic 3D multi-physics sandbox game for the browser",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:test": "node tools/build-test.js",
    "preview": "vite preview --outDir dist-test --port 4181 --strictPort",
    "typecheck": "tsc -p tsconfig.sim.json && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint . && node tools/content-lint.ts",
    "lint:content": "node tools/content-lint.ts",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "verify:fast": "node tools/verify-fast.ts",
    "test:unit": "vitest run --project unit",
    "test:validation": "vitest run --project validation",
    "test:dmath:full": "vitest run --project dmath-full",
    "test:golden": "vitest run --project golden && playwright test tests/e2e/golden.spec.ts",
    "test:fuzz": "vitest run --project fuzz",
    "test:gpu": "node --test tests/gpu/ && node tools/wgsl-validate.ts",
    "missions:verify": "node tools/missions-verify.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts --project=chromium",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:soak": "playwright test tests/e2e/soak.spec.ts --project=chromium",
    "perf:mac": "node tools/perf-mac.ts",
    "gate": "node tools/gate.ts",
    "size:check": "node tools/size-check.js dist",
    "golden:write": "node tools/golden.ts --write",
    "counts:update": "node tools/check-counts.ts --update",
    "engines:mac": "node tools/engine-check.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "0.21.0",
    "comlink": "4.4.2",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@preact/signals": "2.11.3",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "@webgpu/types": "0.1.74",
    "decimal.js": "10.6.0",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "preact": "11.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "webgpu": "0.6.2",
    "zustand": "5.0.15"
  }
}
